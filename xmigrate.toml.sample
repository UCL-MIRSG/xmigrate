[tool.xmigrate.migrate]
source = "https://xnat.example"
source_projects= '["proj1", "proj2"]' # optional so can be removed as default is None, do not set to empty list []
source_rsync = "/original/local/path/"
destination = "https://another-xnat.example"
logging_file_path = "/xmigrate-configs/path/"
destination_projects = '["proj11", "proj12"]' # optional so can be removed as default is None
destination_secondary_ids = '["Dest ID11", "Dest ID12"]' # optional so can be removed as default is None
destination_project_names = '["Destination Project 11", "Destination Project 12"]' # optional so can be removed as default is None
destination_rsync = "/new/local/path/"
include_rsync = true # optional so can be removed as default is true

[tool.xmigrate.rsync]
source_projects= '["proj1", "proj2"]' # optional so can be removed as default is None, do not set to empty list []
source_rsync = "/original/local/path/"
destination_projects = '["proj11", "proj12"]' # optional so can be removed as default is None, do not set to empty list []
destination_rsync = "/new/local/path/"
logging_folder_path = "/xmigrate-configs/path/"
